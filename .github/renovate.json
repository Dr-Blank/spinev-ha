{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "timezone": "Asia/Kolkata",
  "schedule": ["* 0-12 * * 1"],
  "platformAutomerge": false,
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true
  },
  "homeassistant-manifest": {
    "managerFilePatterns": ["/^custom_components/[^/]+/manifest\\.json$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update ruff required-version in pyproject.toml",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": ["required-version = \">=(?<currentValue>[\\d.]+)\""],
      "depNameTemplate": "ruff",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "pytest-homeassistant-custom-component pins an exact homeassistant release",
      "matchPackageNames": [
        "homeassistant",
        "pytest-homeassistant-custom-component"
      ],
      "groupName": "Home Assistant"
    },
    {
      "description": "Keep the ruff pin, pre-commit hook and required-version in step",
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff"
    },
    {
      "description": "A requirement bump needs an integration release; manifest.json keeps a floor at or below the version Home Assistant core pins",
      "matchManagers": ["homeassistant-manifest"],
      "groupName": "integration requirements",
      "automerge": false
    },
    {
      "matchDepTypes": ["project.dependencies"],
      "groupName": "integration requirements",
      "automerge": false
    },
    {
      "description": "Pinned to the versions Home Assistant's bluetooth integration requires; bump them along with homeassistant",
      "matchPackageNames": [
        "bleak",
        "bleak-retry-connector",
        "bluetooth-adapters",
        "bluetooth-auto-recovery",
        "bluetooth-data-tools",
        "dbus-fast",
        "habluetooth",
        "aiousbwatcher",
        "serialx"
      ],
      "enabled": false
    }
  ]
}
